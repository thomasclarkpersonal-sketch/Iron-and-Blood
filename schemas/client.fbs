// Client -> server messages (D22). See docs/NETWORK_PROTOCOL.md.

include "common.fbs";

namespace pax.net;

/// First message on every connection. Anything else first is a protocol error.
table Hello {
  protocol_major: ushort;
  protocol_minor: ushort;
  /// Display name, at most 32 bytes of UTF-8.
  client_name: string;
  /// Nation to play, as an index into the Welcome's nation table.
  /// Absent: sandbox, so the session may command every nation. Only a server run
  /// with --sandbox accepts it (D24); single player launches its server that way.
  /// In a multiplayer lobby (protocol 1.4) it is the player's first claim, and
  /// absent means no claim yet: ClaimNation changes it until the game starts.
  requested_nation: uint = null;
  /// M4: token from an earlier Welcome, to reclaim a dropped session. 0 = new session.
  resume_token: ulong;
}

/// Ask for a command to be applied at the start of the next tick.
/// The server answers every SubmitCommand with exactly one CommandResult.
table SubmitCommand {
  /// Chosen by the client and echoed in the CommandResult. It doesn't affect ordering.
  client_seq: uint;
  command: Command;
}

/// Host only, except that any player may pause (D24). A refused change is answered
/// with ServerState, the speed unchanged.
table SetSpeed {
  speed: Speed;
}

/// Replaces the session's whole subscription. The server answers with a DayUpdate
/// for the current day, so a newly opened panel fills at once, even when paused.
table Subscribe {
  map_mode: MapMode;
  /// Good index for MapMode.Price.
  map_good: ushort;
  /// Market whose detail to send; absent for none.
  market: uint = null;
  /// Province whose POPs, labour and producers to send; absent for none.
  province: uint = null;
}

/// The client has finished processing the DayUpdate for `day` (flow control, D23).
table Ack {
  day: ulong;
}

/// Keep-alive, also used to measure round-trip time. Sent at least every 2 seconds.
table Ping {
  nonce: ulong;
}

/// Host only (D24); anyone else gets a SaveResult with the error.
table SaveGame {
  /// File name stem: [A-Za-z0-9_-], 1 to 64 characters.
  name: string;
}

/// Host only (D24); anyone else gets a SaveResult with the error. M4-5 moves
/// loading into the lobby.
table LoadGame {
  name: string;
}

table ListSaves {}

/// Host only (D24): end another player's session, which gets a Goodbye saying it was
/// kicked. Added in protocol 1.3. Ignored from anyone else, for the host itself, and
/// for a player who isn't connected.
table Kick {
  player: ushort;
}

/// In the lobby (D24, protocol 1.4): claim a nation, or with `nation` absent give up
/// the claim. A nation another player holds is refused. Claiming clears this
/// player's ready mark. The answer is a LobbyState.
table ClaimNation {
  nation: uint = null;
}

/// In the lobby: mark this player ready, or not (protocol 1.4). A player can only be
/// ready while holding a nation (or a sandbox seat). The answer is a LobbyState.
table SetReady {
  ready: bool;
}

/// Host only, in the lobby (protocol 1.4): start the game once every player is ready.
/// The answer is a LobbyState with `started` set, sent to everyone.
table StartGame {}

union ClientPayload {
  Hello,
  SubmitCommand,
  SetSpeed,
  Subscribe,
  Ack,
  Ping,
  SaveGame,
  LoadGame,
  ListSaves,
  Kick,
  ClaimNation,
  SetReady,
  StartGame,
}

table ClientMessage {
  payload: ClientPayload;
}

root_type ClientMessage;
file_identifier "PAXC";
